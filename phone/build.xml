<?xml version="1.0" encoding="utf-8"?>

<project name="Phone" default="build" basedir=".">

	<!-- ===================================================== -->
	<!-- Local defaults                                        -->
	<!-- В Docker переопределяются через -D                    -->
	<!-- ===================================================== -->

	<property name="gwt.sdk" location="C:/gwt/gwt-2.7.0" />

	<property name="gwt.libs" location="C:/java/libs" />

	<!-- GWT 2.7 запускаем именно через Java 8 -->
	<property name="gwt.java" location="C:/Program Files/Java/jdk1.8.0_241/bin/java.exe" />

	<property name="gwt.args" value="" />

	<property name="gwt.module" value="phone.Phone" />


	<!-- ===================================================== -->
	<!-- Project directories                                   -->
	<!-- ===================================================== -->

	<property name="src.dir" location="src" />

	<property name="war.dir" location="war" />

	<property name="classes.dir" location="${war.dir}/WEB-INF/classes" />

	<property name="lib.dir" location="${war.dir}/WEB-INF/lib" />

	<property name="war.file" location="phone.war" />


	<!-- ===================================================== -->
	<!-- Classpath                                             -->
	<!-- ===================================================== -->

	<path id="project.class.path">

		<!-- Скомпилированные классы -->
		<pathelement location="${classes.dir}" />

		<!-- GWT -->
		<pathelement location="${gwt.sdk}/gwt-user.jar" />

		<pathelement location="${gwt.sdk}/gwt-dev.jar" />

		<pathelement location="${gwt.sdk}/validation-api-1.0.0.GA.jar" />

		<pathelement location="${gwt.sdk}/validation-api-1.0.0.GA-sources.jar" />

		<!--
            Внешние зависимости:
            Gson
            MyBatis
            PostgreSQL JDBC
            и т.д.
        -->
		<fileset dir="${gwt.libs}">
			<include name="*.jar" />
		</fileset>

		<!-- Библиотеки внутри WAR -->
		<fileset dir="${lib.dir}" erroronmissingdir="false">

			<include name="*.jar" />

		</fileset>

	</path>


	<!-- ===================================================== -->
	<!-- Libraries                                             -->
	<!-- ===================================================== -->

	<target name="libs" description="Copy libraries to WEB-INF/lib">

		<mkdir dir="${lib.dir}" />

		<!-- GWT runtime -->
		<copy todir="${lib.dir}">

			<fileset dir="${gwt.sdk}">

				<include name="gwt-servlet.jar" />
				<include name="gwt-servlet-deps.jar" />

			</fileset>

		</copy>

		<!-- Gson, MyBatis, PostgreSQL и другие jar -->
		<copy todir="${lib.dir}">

			<fileset dir="${gwt.libs}">

				<include name="*.jar" />

			</fileset>

		</copy>

	</target>


	<!-- ===================================================== -->
	<!-- Java compilation                                      -->
	<!-- ===================================================== -->

	<target name="javac" depends="libs" description="Compile Java source to bytecode">

		<mkdir dir="${classes.dir}" />

		<javac srcdir="${src.dir}" destdir="${classes.dir}" encoding="utf-8" source="1.8" target="1.8" includeantruntime="false" nowarn="true" debug="true" debuglevel="lines,vars,source">

			<classpath refid="project.class.path" />

		</javac>


		<!--
            Копируем ресурсы из src:
            XML
            properties
            MyBatis config
            MyBatis mapper и т.д.
        -->
		<copy todir="${classes.dir}">

			<fileset dir="${src.dir}">

				<exclude name="**/*.java" />

			</fileset>

		</copy>

	</target>


	<!-- ===================================================== -->
	<!-- GWT compilation                                       -->
	<!-- ===================================================== -->

	<target name="gwtc" depends="javac" description="Compile GWT client to JavaScript">

		<java failonerror="true" fork="true" jvm="${gwt.java}" classname="com.google.gwt.dev.Compiler" maxmemory="512m">

			<classpath>

				<!-- GWT должен видеть Java-исходники -->
				<pathelement location="${src.dir}" />

				<path refid="project.class.path" />

			</classpath>


			<!-- Куда складывать скомпилированный JS -->
			<arg value="-war" />
			<arg value="${war.dir}" />

			<!-- Дополнительные аргументы -->
			<arg line="${gwt.args}" />

			<!-- GWT module -->
			<arg value="${gwt.module}" />

		</java>

	</target>


	<!-- ===================================================== -->
	<!-- Development mode                                      -->
	<!-- ===================================================== -->

	<target name="devmode" depends="javac" description="Run GWT development mode">

		<java failonerror="true" fork="true" jvm="${gwt.java}" classname="com.google.gwt.dev.DevMode" maxmemory="1g">

			<classpath>

				<pathelement location="${src.dir}" />

				<path refid="project.class.path" />

				<pathelement location="${gwt.sdk}/gwt-codeserver.jar" />

			</classpath>


			<arg value="-startupUrl" />
			<arg value="Phone.html" />

			<arg value="-war" />
			<arg value="${war.dir}" />

			<arg line="${gwt.args}" />

			<arg value="${gwt.module}" />

		</java>

	</target>


	<!-- ===================================================== -->
	<!-- Build                                                 -->
	<!-- ===================================================== -->

	<target name="build" depends="gwtc" description="Build project" />


	<!-- ===================================================== -->
	<!-- WAR                                                   -->
	<!-- ===================================================== -->

	<target name="war" depends="build" description="Create phone.war">

		<!-- На всякий случай удаляем старый WAR -->
		<delete file="${war.file}" failonerror="false" />

		<zip destfile="${war.file}" basedir="${war.dir}" />

	</target>


	<!-- ===================================================== -->
	<!-- Clean                                                 -->
	<!-- ===================================================== -->

	<target name="clean" description="Clean generated files">

		<!-- Java classes -->
		<delete dir="${classes.dir}" failonerror="false" />

		<!-- GWT deploy -->
		<delete dir="${war.dir}/WEB-INF/deploy" failonerror="false" />

		<!-- Скомпилированный GWT JavaScript -->
		<delete dir="${war.dir}/phone" failonerror="false" />

		<!-- Старый WAR -->
		<delete file="${war.file}" failonerror="false" />

	</target>

</project>